---
import CourseLayout from '../layouts/CourseLayout.astro';
import { site } from '../config';

const base = import.meta.env.BASE_URL || '/';
---

<CourseLayout title="页面未找到">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32 text-center">
    <p class="font-mono text-xs tracking-[0.18em] text-ink-faint">ERROR 404</p>
    <h1 class="mt-4 font-serif text-6xl sm:text-7xl font-semibold tracking-tight text-ink">
      页面未找到
    </h1>
    <p class="mx-auto mt-6 max-w-md text-lg leading-relaxed text-ink-muted">
      你访问的地址不存在，或内容已被移动。返回教学计划，从第一讲重新开始。
    </p>
    <a
      href={base}
      class="mt-10 inline-flex items-center gap-2 px-5 py-2.5 bg-solid text-white text-sm font-medium rounded-md hover:bg-solid-hover active:scale-[0.98] transition-all duration-200"
    >
      ← 返回 {site.title}
    </a>
  </div>
</CourseLayout>
