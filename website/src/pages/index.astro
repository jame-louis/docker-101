---
import CourseLayout from '../layouts/CourseLayout.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';

const base = import.meta.env.BASE_URL || '/';

// The homepage is the course content list, derived entirely from lecture frontmatter.
// (The course intro lives in lecture 1, so there is no separate syllabus document.)
const lectures = await getCollection('lectures');
const schedule = lectures
  .filter(l => !l.data.draft)
  .sort((a, b) => a.data.lectureNumber - b.data.lectureNumber);

// Homework lookup by lecture slug (an assignment's `lectureRef` points at its lecture).
const assignments = await getCollection('assignments');
const liveAssignments = assignments.filter(a => !a.data.draft);
const assignmentByLecture = new Map(liveAssignments.map(a => [a.data.lectureRef, a]));
---

<CourseLayout title={site.title}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Hero: the course intro as a scholarly title block. -->
    <header class="pt-8 pb-5 sm:pt-10 sm:pb-6">
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1.5">
        <p class="flex items-center gap-3 font-mono text-xs tracking-[0.18em] text-ink-faint">
          <span class="h-px w-8 bg-primary/40" aria-hidden="true"></span>
          课程大纲 · COURSE SYLLABUS
        </p>
        <dl class="flex items-center gap-x-4 font-mono text-[0.7rem] tracking-[0.14em] text-ink-faint sm:gap-x-5">
          <div class="flex items-baseline gap-1.5"><dt>学期</dt><dd class="font-sans font-medium tracking-normal text-ink">{site.term}</dd></div>
          <div class="flex items-baseline gap-1.5"><dt>讲授</dt><dd class="font-sans font-medium tracking-normal tabular-nums text-ink">{schedule.length} 讲</dd></div>
          <div class="flex items-baseline gap-1.5"><dt>作业</dt><dd class="font-sans font-medium tracking-normal tabular-nums text-ink">{liveAssignments.length} 份</dd></div>
        </dl>
      </div>
      <h1 class="mt-3 font-serif text-3xl sm:text-4xl font-semibold tracking-[-0.02em] leading-[1.15] text-balance">
        {site.title}
      </h1>
      <p class="mt-2.5 max-w-xl text-base sm:text-[1.0625rem] leading-relaxed text-ink-muted">
        {site.description}
      </p>
    </header>

    <!-- The schedule: a numbered table of contents, one row per lecture. -->
    <section aria-labelledby="schedule-heading" class="pb-4 sm:pb-6">
      <div class="flex items-baseline justify-between border-b border-line pb-2">
        <h2 id="schedule-heading" class="font-serif text-base font-semibold tracking-tight">
          教学计划
        </h2>
        <span class="font-mono text-xs tracking-[0.18em] text-ink-faint">{schedule.length} 讲</span>
      </div>

      <ol class="divide-y divide-line">
        {schedule.map((lecture, i) => {
          const slug = lecture.id.replace('.md', '');
          const hw = assignmentByLecture.get(slug);
          const num = String(lecture.data.lectureNumber).padStart(2, '0');
          return (
            <li class="group grid grid-cols-[2.5rem_1fr_auto] items-baseline gap-1 -mx-1 rounded-lg px-1 py-1 transition-colors duration-200 active:bg-primary-soft/90">
              <span class="font-serif text-lg tabular-nums text-ink-faint transition-colors group-hover:text-primary">
                {num}
              </span>
              <span class="block font-medium text-[1rem] text-ink transition-colors group-hover:text-primary-dark">
                <a
                  href={`${base}lectures/${slug}`}
                  class="min-w-0"
                >
                    {lecture.data.title}
                </a>
              </span>
              <span class="flex items-center gap-2 whitespace-nowrap">
                {lecture.data.slidevUrl && (
                  <a
                    href={base+lecture.data.slidevUrl}
                    target="_blank"
                    rel="noopener"
                    class="meta-tag group-hover:border-primary/25 group-hover:text-primary-dark hover:border-primary/40"
                  >
                    课件
                  </a>
                )}
                {hw && (
                  <a
                    href={`${base}assignments/${hw.id.replace('.md', '')}`}
                    class="meta-tag group-hover:border-primary/25 group-hover:text-primary-dark hover:border-primary/40"
                  >
                    作业{hw.data.assignmentNumber}
                  </a>
                )}
                {hw?.data.dueDate && (
                  <span class="due-tag" title="截止日期">
                    截止 {hw.data.dueDate.toLocaleDateString('zh-CN')}
                  </span>
                )}
              </span>
            </li>
          );
        })}
      </ol>
    </section>
  </div>
</CourseLayout>
