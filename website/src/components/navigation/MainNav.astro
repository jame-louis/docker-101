---
import { site } from '../../config';

const base = import.meta.env.BASE_URL || '/';
---

<!-- Top bar: brand only. The site has one content page plus the homepage list,
     so the title itself is the only navigation needed (it links home). -->
<nav class="bg-paper/80 backdrop-blur border-b border-line sticky top-0 z-40">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center h-16">
      <a href={base} class="group flex items-center gap-2.5" aria-label="返回课程主页">
        <span
          class="flex h-5 w-5 items-center justify-center rounded-[0.25rem] border border-primary/40 transition-colors duration-300 group-hover:border-primary"
          aria-hidden="true"
        >
          <span class="h-1.5 w-1.5 rotate-45 bg-primary transition-transform duration-300 group-hover:rotate-[135deg]"></span>
        </span>
        <span class="font-serif text-lg font-semibold tracking-tight text-ink whitespace-nowrap">
          {site.title}
        </span>
      </a>
    </div>
  </div>
</nav>
