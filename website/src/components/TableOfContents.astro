---
interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;
---

<nav class="sticky top-24 w-48 max-h-[calc(100vh-6rem)] overflow-y-auto" aria-label="本页目录">
  <p class="flex items-center gap-2 font-mono text-xs tracking-[0.18em] text-ink-faint">
    <span class="inline-block h-1 w-1 rotate-45 bg-primary" aria-hidden="true"></span>
    目录
  </p>
  <ul class="mt-3 space-y-1 border-l border-line">
    {headings.map(h => (
      <li>
        <a
          href={`#${h.slug}`}
          class={`block text-sm leading-relaxed text-ink-muted border-l-2 border-transparent -ml-px pl-3 hover:text-primary hover:border-primary/40 transition-colors ${
            h.depth === 2 ? 'py-1' : 'pl-7'
          }`}
        >
          {h.text}
        </a>
      </li>
    ))}
  </ul>
</nav>
